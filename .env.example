# Copy to .env and fill in. Never commit .env.

# Paywall: x402 (x402 exact, USDC, gasless for the payer, on the networks below), ping (PingPay, mainnet),
# none (development). `near` is the old name of x402 with one NEAR network.
PAYWALL=x402
# Where customers may pay, comma-separated: near:mainnet, eip155:8453 (Base), eip155:1 (Ethereum).
# The 402 offers them all; the payer picks one. (Not which chain is read: that is per request.)
# No default. The image is a production build and refuses to start with a testnet network,
# PAYWALL=none or EIGENBELEG_DEV_TESTNET (apps/api/src/release.js).
PAY_NETWORKS=near:mainnet
# Development only, never in production: near:testnet in PAY_NETWORKS needs EIGENBELEG_DEV_TESTNET=1.
# EIGENBELEG_DEV_TESTNET=1
# Prices: the published list in packages/pipeline/src/prices.js ($0.10, on Ethereum $1.00), which the
# page shows too. A production build refuses PRICE / PRICE_<NETWORK> / PRICE_SUBSCRIPTION* that differ
# from it; in development they may: PRICE for every network, PRICE_<NETWORK with : as _> for one.
# PRICE=$0.10
# PRICE_EIP155_1=$1.00
# How far ahead a payer's signed delegate may expire, in seconds (1 block ≈ 1 s). Browser wallets
# such as Meteor sign with 200 blocks, so keep this at 300 or more for the web UI.
PAY_TIMEOUT_SECONDS=300
# The NEAR account that receives the USDC (must be registered with the USDC contract: storage_deposit)
PAY_TO=
# The NEAR account that submits the payer's signed delegate action and pays its gas (needs a little NEAR).
# Its key: RELAYER_SECRET_KEY, or the near-cli legacy keychain file ~/.near-credentials/<network>/<id>.json
RELAYER_ACCOUNT_ID=
RELAYER_SECRET_KEY=
# Base and Ethereum (eip155:8453, eip155:1): the 0x address that receives the USDC, and the 0x private key of
# the account that submits the payer's signed EIP-3009 transfer and pays its gas (needs a little ETH on each
# of those networks). RPC: EVM_RPC_EIP155_8453 / EVM_RPC_EIP155_1, else Alchemy with ALCHEMY_KEY, else public.
PAY_TO_EVM=
EVM_RELAYER_KEY=

# The test route, POST /testnet/eigenbeleg, in production too: testnet data only, paid with testnet USDC
# on NEAR testnet, every PDF marked TESTNET; 30 requests an hour per IP, 31 days, 20 mails a day in all.
# Its own recipient and relayer (….testnet accounts; the relayer needs a little testnet NEAR), never the
# mainnet ones. Empty TESTNET_PAY_TO: the route is off (404).
TESTNET_PAY_TO=
TESTNET_RELAYER_ACCOUNT_ID=
TESTNET_RELAYER_SECRET_KEY=
# TESTNET_NEAR_RPC_URL=

# PingPay Agent Pay (PAYWALL=ping, mainnet only)
PING_API_KEY=
PING_FACILITATOR_URL=https://pay.pingpay.io/agentpay/x402
PING_AMOUNT_OUT=200000

# Optional: a NearBlocks API key for higher rate limits
NEARBLOCKS_API_KEY=

# Optional: an Alchemy key. With it the API also serves Ethereum and Base
# (ETH, USDC, ALEPH); without it, it does not offer them. Never given to the web UI.
ALCHEMY_KEY=

# Optional: the files by mail, when a request asks for it (email). The SMTP account as a URL
# (smtps://user:password@mail.example.org:465, or smtp://… with STARTTLS) and the sender.
# Without SMTP_URL the API offers no mail. Never commit the password.
SMTP_URL=
MAIL_FROM=Eigenbeleg <eigenbelege@example.org>

# Optional: subscriptions (POST /eigenbeleg/subscribe, issue #20): twelve monthly Kontoauszüge by mail,
# paid once. Needs mail. The subscriptions are the one thing the API keeps: one file each in
# SUBSCRIPTION_DIR (the compose volume), encrypted with SUBSCRIPTION_KEY (any 16+ characters; losing
# it loses them). Without the key the API offers no subscriptions. Price: PRICE_SUBSCRIPTION, else
# 12 × the price; per network PRICE_SUBSCRIPTION_<NETWORK> (development only, see Prices above).
SUBSCRIPTION_KEY=
SUBSCRIPTION_DIR=/var/lib/eigenbeleg

# Optional: where a logo sent with the free preview is kept for 24 hours (encrypted with a key made
# from its id, deleted by an hourly sweep), so the paid request names its id instead of sending it
# again. Default: SUBSCRIPTION_DIR/logos where SUBSCRIPTION_DIR is set; with neither, nothing is kept.
# LOGO_DIR=/var/lib/eigenbeleg/logos
# PRICE_SUBSCRIPTION=$1.20

HOST=127.0.0.1
PORT=4402

# The agent (npm run agent)
API_URL=http://127.0.0.1:4402
AGENT_ACCOUNT_ID=
AGENT_SECRET_KEY=
# Optional: a 0x private key with USDC on Base or Ethereum; the agent then pays there too (gasless).
AGENT_EVM_KEY=
# When the API offers several networks: the one to pay on (near:mainnet, eip155:8453, eip155:1); else the API's first
PAY_PREFER=
AGENT_BUDGET=$0.25
# NEAR AI Agent Market (npm run agent:market): the agent token aat_… from the listing
MARKET_TOKEN=
# Optional: NEAR AI Cloud, for notes when the agent drafts a missing building block
NEARAI_API_KEY=

# AGPL-3.0-or-later, section 13: where users of this running API get its source (your fork, if you changed it)
SOURCE_URL=https://github.com/Le-Space/eigenbeleg-agent
# This instance's public origin, for the share cards (Open Graph, X) on /ui/.
# Unset: taken from the request's Host and X-Forwarded-Proto.
# PUBLIC_URL=https://eigenbeleg.le-space.de

# Behind a reverse proxy: trust its X-Forwarded-Proto (Express syntax, e.g. uniquelocal or a subnet), so x402 names the https URL
TRUST_PROXY=
