# Copy to .env and fill in. Never commit .env.

# Paywall: near (x402 exact on NEAR, USDC, gasless for the payer), ping (PingPay, mainnet), none (development)
PAYWALL=near
PAY_NETWORK=near:testnet
PRICE=$0.10
# The NEAR account that receives the USDC (must be registered with the USDC contract: storage_deposit)
PAY_TO=
# The NEAR account that submits the payer's signed delegate action and pays its gas (needs a little NEAR).
# Its key: RELAYER_SECRET_KEY, or the near-cli legacy keychain file ~/.near-credentials/testnet/<id>.json
RELAYER_ACCOUNT_ID=
RELAYER_SECRET_KEY=

# PingPay Agent Pay (PAYWALL=ping, mainnet only)
PING_API_KEY=
PING_FACILITATOR_URL=https://pay.pingpay.io/agentpay/x402
PING_AMOUNT_OUT=200000

# Optional: a NearBlocks API key for higher rate limits
NEARBLOCKS_API_KEY=

HOST=127.0.0.1
PORT=4402
